# better-auth — সিক্রেট তৈরি করুন: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# ক্লায়েন্ট ও সার্ভার আলাদা ডোমেইনে হলে (ঐচ্ছিক)
# NEXT_PUBLIC_BETTER_AUTH_URL=https://your-domain.com

# MongoDB Atlas — SRV URI
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Node যদি SRV রেকর্ড রিজলভ করতে না পারে (querySrv ECONNREFUSED), সরাসরি সিড হোস্ট ব্যবহার করুন:
# MONGODB_URI=mongodb://user:password@host0:27017,host1:27017,host2:27017/?ssl=true&authSource=admin
